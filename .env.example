# ==============================================================================
# LiveCalicut — Paid Ads Landing Page Environment Configuration
# ==============================================================================
# Server-side only variables. Never expose RESEND_API_KEY to client code.

# 1. Official LiveCalicut lead receiver email (Where new registrations are delivered)
LIVECALICUT_LEADS_EMAIL=hello@livecalicut.com

# 2. Resend API Key for transactional notification dispatch (https://resend.com)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# 3. Verified Sender address registered with your Resend account domain
# Default test sender if no custom domain yet: onboarding@resend.dev
EMAIL_FROM=LiveCalicut Registrations <onboarding@resend.dev>

# 4. Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://livecalicut.com

# 5. LiveCalicut Official WhatsApp Contact
# Set the international format phone number without plus (e.g. 919539980990 for +91 95399 80990)
NEXT_PUBLIC_WHATSAPP_NUMBER=919539980990
NEXT_PUBLIC_WHATSAPP_DISPLAY=+91 95399 80990

# 6. Google Sheets Integration (Google Apps Script Web App Webhook)
# All form submissions will automatically append as new rows to your Google Sheet:
# https://docs.google.com/spreadsheets/d/1g_c9WbrMvUG6LDqmNmbUHuSnZQeBJzYJwsyL_eN-1c8/edit
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id_here/exec
